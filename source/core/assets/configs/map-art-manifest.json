{
  "viewport": [
    1280,
    720
  ],
  "filter": "Nearest",
  "world": {
    "lv2": {
      "width": 1280,
      "height": 2880
    }
  },
  "parallaxRule": "vertical layer height = 720 + (worldHeight-720) * factor; draw at y = camBottom*(1-factor)",
  "backgrounds": {
    "lv1-dungeon": [
      {
        "file": "images/level1/backgrounds/dungeon/0-back.png",
        "type": "loopX",
        "factor": 0.05
      },
      {
        "file": "images/level1/backgrounds/dungeon/1-arcade.png",
        "type": "loopX",
        "factor": 0.2
      },
      {
        "file": "images/level1/backgrounds/dungeon/2-pillars.png",
        "type": "loopX",
        "factor": 0.45
      },
      {
        "file": "images/level1/backgrounds/dungeon/3-fog.png",
        "type": "loop",
        "factor": 0.6,
        "drift": [
          10,
          0
        ]
      }
    ],
    "lv1-underworld": [
      {
        "file": "images/level1/backgrounds/underworld/0-void.png",
        "type": "static"
      },
      {
        "file": "images/level1/backgrounds/underworld/1-far-arches.png",
        "type": "loopX",
        "factor": 0.18
      },
      {
        "file": "images/level1/backgrounds/underworld/2-columns.png",
        "type": "loopX",
        "factor": 0.4
      },
      {
        "file": "images/level1/backgrounds/underworld/3-embers-loop.png",
        "type": "loop",
        "factor": 0.9,
        "drift": [
          6,
          30
        ]
      },
      {
        "file": "images/level1/backgrounds/underworld/4-foreground.png",
        "type": "loopX",
        "factor": 1.2,
        "note": "draw after the tile map"
      }
    ],
    "lv2-olympus": [
      {
        "file": "images/level2/backgrounds/0-sky.png",
        "type": "vertical",
        "factor": 0.1,
        "size": [
          1280,
          936
        ]
      },
      {
        "file": "images/level2/backgrounds/1-far-sea.png",
        "type": "vertical",
        "factor": 0.2,
        "size": [
          1280,
          1152
        ]
      },
      {
        "file": "images/level2/backgrounds/2-ranges.png",
        "type": "vertical",
        "factor": 0.35,
        "size": [
          1280,
          1476
        ]
      },
      {
        "file": "images/level2/backgrounds/3-cloudbanks.png",
        "type": "vertical",
        "factor": 0.85,
        "size": [
          1280,
          2556
        ]
      },
      {
        "file": "images/level2/backgrounds/4-wisps-loop.png",
        "type": "loop",
        "factor": 1.15,
        "drift": [
          8,
          0
        ],
        "note": "after the tile map"
      },
      {
        "file": "images/level2/backgrounds/5-storm-rain-loop.png",
        "type": "loop",
        "factor": 1,
        "drift": [
          -40,
          -260
        ],
        "note": "storm belt rows 20–49 only"
      }
    ]
  },
  "animations": {
    "images/level1/ambience/torch-flame-sheet-8f.png": {
      "frames": 8,
      "frame": [
        32,
        48
      ],
      "fps": 12,
      "loop": true,
      "with": "images/level1/ambience/torch-sconce.png + images/effects/lighting/light-warm.png"
    },
    "images/level1/ambience/lava-flow-sheet-4f.png": {
      "frames": 4,
      "layout": "vertical",
      "frame": [
        1280,
        48
      ],
      "fps": 6,
      "loop": true,
      "tileX": true
    },
    "images/level2/ambience/lightning-bolt-sheet-6f.png": {
      "frames": 6,
      "frame": [
        96,
        256
      ],
      "fps": 20,
      "loop": false,
      "trigger": "random 3–7s in storm belt + white screen flash 0.08s"
    },
    "images/level2/ambience/bird-flap-sheet-4f.png": {
      "frames": 4,
      "frame": [
        32,
        24
      ],
      "fps": 8,
      "loop": true
    },
    "images/level2/ambience/cloud-{dawn|noon|storm}-{1..3}.png": {
      "type": "sprite",
      "note": "spawn off-screen, drift 4–14 px/s, pick palette by altitude"
    },
    "images/level2/cloud-platforms/cloud-fade-*-sheet-4f.png": {
      "frames": 4,
      "frame": [
        16,
        24
      ],
      "fps": 8,
      "loop": false,
      "note": "play on land; reverse to reform"
    },
    "images/level2/cloud-platforms/cloud-storm-*-sheet-3f.png": {
      "frames": 3,
      "frame": [
        16,
        24
      ],
      "note": "0 idle, 1 charging, 2 electrified"
    },
    "images/level2/cloud-platforms/cloud-thermal-*-sheet-2f.png": {
      "frames": 2,
      "frame": [
        16,
        24
      ],
      "fps": 4,
      "loop": true
    }
  },
  "cloudPlatforms": {
    "pieces": [
      "left",
      "mid",
      "right"
    ],
    "size": [
      16,
      24
    ],
    "collisionTopY": 6,
    "note": "place art 6px above the 16px collision cell"
  },
  "fonts": [
    "fonts/olympus/olympus-pixel-14.fnt",
    "fonts/olympus/olympus-pixel-28.fnt",
    "fonts/olympus/olympus-pixel-bold-14.fnt",
    "fonts/olympus/olympus-pixel-bold-28.fnt"
  ]
}
