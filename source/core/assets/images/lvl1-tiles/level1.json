  "route": [
    {
      "step": 1,
      "zone": "catacombs",
      "beat": "Spawn at the stele of the hero before you. Take their xiphos."
    },
    {
      "step": 2,
      "zone": "catacombs",
      "beat": "East through the spike run under a swinging blade, to a locked bronze gate."
    },
    {
      "step": 3,
      "zone": "catacombs",
      "beat": "Back west and up: the pit room, then the fire hall."
    },
    {
      "step": 4,
      "zone": "catacombs",
      "beat": "Down the east ladder into the vault. The chest holds the bronze key."
    },
    {
      "step": 5,
      "zone": "catacombs",
      "beat": "Unlock the gate, climb to the lift hall. Optional: the hoplon in the treasury."
    },
    {
      "step": 6,
      "zone": "lift",
      "beat": "Ride the lift up through the crust seam."
    },
    {
      "step": 7,
      "zone": "cavern",
      "beat": "You surface on the bank of the Styx. The architecture changes — no more rooms, one open cavern."
    },
    {
      "step": 8,
      "zone": "cavern",
      "beat": "Climb the terraces and the bone bridge. Cerberus guards the east switchback."
    },
    {
      "step": 9,
      "zone": "cavern",
      "beat": "Take the bolt from the high terrace."
    },
    {
      "step": 10,
      "zone": "tunnel",
      "beat": "Three bronze flights up the east wall into a worked-stone tunnel. Climb the stair west to the door. DESTINATION: LEVEL 2."
    }
  ],
